# Codigo de la aplicacion: nunca se sirve por HTTP, solo se incluye desde
# public/index.php con require. Este archivo se versiona (a diferencia de
# vendor/.htaccess), asi que la proteccion no depende de mod_rewrite.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
