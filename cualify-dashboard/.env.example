# ---------------------------------------------------------------------------
# Panel Cualify — copiar a .env y completar.
# NUNCA commitear el .env real.
# ---------------------------------------------------------------------------

# Entorno: local | production
APP_ENV=local
APP_DEBUG=true

# URL base del panel. OPCIONAL: si se omite, se autodetecta desde el servidor
# (esquema + host + prefijo real de la carpeta public/), que es lo recomendado.
# Solo es obligatoria para CLI o para RewriteBase manual en public/.htaccess.
# APP_URL=https://eiso.com.co/cualify/cualify-dashboard/public

# Conexion a la MISMA base de datos que usa el bot.
# Ojo: el usuario root de MariaDB autentica por unix_socket, asi que desde
# PHP-FPM (que corre como 'apache') hay que entrar por TCP con 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=db_cualify
DB_USER=root
DB_PASS=TU_CLAVE

# Zona horaria de los filtros y agregaciones del panel.
APP_TIMEZONE=America/Bogota
