# --- WhatsApp Cloud API (ya existentes) ---
WA_VERIFY_TOKEN=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Opcional: valida la firma X-Hub-Signature-256 de cada webhook
WA_APP_SECRET=

# --- Base de datos (ya existentes) ---
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=

# --- Google PageSpeed Insights (nuevo) ---
# Generar en: https://console.cloud.google.com/ > APIs & Services > Credentials
# (habilitar antes "PageSpeed Insights API" en la Library)
PSI_API_KEY=

# --- Google Calendar (nuevo) ---
# Ruta absoluta al JSON de la cuenta de servicio (fuera del webroot público)
GOOGLE_SERVICE_ACCOUNT_JSON=/ruta/absoluta/secrets/google-service-account.json
# Calendario donde se insertan las citas
GOOGLE_CALENDAR_ID=andres.tabares@eiso.com.co
# Correo a impersonar vía Domain-Wide Delegation (normalmente el mismo que GOOGLE_CALENDAR_ID)
GOOGLE_IMPERSONATE_EMAIL=andres.tabares@eiso.com.co
