# Meta / WhatsApp Business
WA_VERIFY_TOKEN=TU_VERIFY_TOKEN
WA_PHONE_NUMBER_ID=TU_PHONE_NUMBER_ID
WA_ACCESS_TOKEN=TU_ACCESS_TOKEN
WA_APP_SECRET=TU_APP_SECRET

# Base de datos MySQL / MariaDB
DB_HOST=localhost
DB_USER=root
DB_PASS=TU_CLAVE
DB_NAME=db_cualify

# Gemini AI Engine
GEMINI_API_KEY=TU_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# PageSpeed Insights
PSI_API_KEY=TU_PSI_API_KEY

# Workers y Speed-to-Lead Ingestion
WORKER_TRIGGER_TOKEN=TU_WORKER_TRIGGER_TOKEN
INBOUND_LEAD_TOKEN=TU_INBOUND_LEAD_TOKEN
INBOUND_DEFAULT_TEMPLATE=cualify_lead_welcome
VENTAS_WHATSAPP_NOTIFY=573001234567

# Google Calendar (Service Account con Domain-Wide Delegation)
GOOGLE_SERVICE_ACCOUNT_JSON=/ruta/absoluta/a/caldav-service-account.json
GOOGLE_CALENDAR_ID=correo@eiso.com.co
GOOGLE_IMPERSONATE_EMAIL=correo@eiso.com.co

# WhatsApp Flows (Llave privada RSA en servidor)
FLOW_PRIVATE_KEY_PATH=/ruta/absoluta/a/private.pem
FLOW_PRIVATE_KEY_PASSPHRASE=
