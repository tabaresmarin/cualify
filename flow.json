{
  "version": "6.0",
  "data_api_version": "3.0",
  "routing_model": {
    "JOIN_NOW": ["WEBSITE_URL"],
    "WEBSITE_URL": ["SUCCESS"],
    "SUCCESS": []
  },
  "screens": [
    {
      "id": "JOIN_NOW",
      "title": "Consultar Tarifas",
      "terminal": false,
      "data": {},
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "¡Bienvenido a EISO!"
          },
          {
            "type": "TextBody",
            "text": "Vamos a analizar el rendimiento de tu sitio web y agendar una asesoría gratuita. Solo te tomará un minuto."
          },
          {
            "type": "Footer",
            "label": "Comenzar",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "WEBSITE_URL"
              },
              "payload": {}
            }
          }
        ]
      }
    },
    {
      "id": "WEBSITE_URL",
      "title": "Tus datos",
      "terminal": false,
      "data": {
        "name": {
          "type": "string",
          "required": true
        },
        "email": {
          "type": "string",
          "required": true
        },
        "website_url": {
          "type": "string",
          "required": true
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Cuéntanos sobre ti"
          },
          {
            "type": "TextInput",
            "name": "name",
            "label": "Nombre",
            "input-type": "text",
            "required": true
          },
          {
            "type": "TextInput",
            "name": "email",
            "label": "Email",
            "input-type": "email",
            "required": true
          },
          {
            "type": "TextInput",
            "name": "website_url",
            "label": "URL de tu sitio web",
            "input-type": "text",
            "helper-text": "Ej: https://tusitio.com",
            "required": true
          },
          {
            "type": "Footer",
            "label": "Enviar",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "name": "${form.name}",
                "email": "${form.email}",
                "website_url": "${form.website_url}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "CONFIRMACION",
      "title": "¡Listo!",
      "terminal": true,
      "data": {
        "name": {
          "type": "string",
          "required": false
        },
        "appointment_label": {
          "type": "string",
          "required": false
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "¡Gracias, ${data.name}!"
          },
          {
            "type": "TextBody",
            "text": "Recibimos tu sitio web. Te enviaremos el diagnóstico por WhatsApp en unos segundos y podrás agendar tu asesoría desde el chat."
          },
          {
            "type": "Footer",
            "label": "Cerrar",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "name": "${data.name}",
                "appointment_label": "${data.appointment_label}"
              }
            }
          }
        ]
      }
    }
  ]
}